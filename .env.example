SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
SENTINEL_INSTANCE_ID=

# Optional. Set when deployed to require a login (username defaults to "aorvis").
# APP_USERNAME=aorvis
# APP_PASSWORD=

# Optional. Postgres connection string (e.g. a free Neon database).
# When set, drawings are stored there instead of in data/kml/.
# DATABASE_URL=
